<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Still.App.Views.BlockedWindow"
        Title="Still"
        WindowState="FullScreen"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        SystemDecorations="None"
        Background="{StaticResource AppBgBrush}">
  <Grid Background="{StaticResource AppBgBrush}">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">
      <Border Width="400"
              Background="#0E1217"
              BorderBrush="#3A4432"
              BorderThickness="1"
              CornerRadius="14"
              Padding="22"
              BoxShadow="0 22 70 0 #52000000">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="40"
                    Height="40"
                    Background="{StaticResource DangerSoftBrush}"
                    CornerRadius="11">
              <Path Data="M12 2l8 4v6c0 5-4 8-8 10c-4-2-8-5-8-10V6z"
                    Stroke="{StaticResource DangerBrush}"
                    StrokeThickness="1.7"
                    Stretch="Uniform"
                    Width="19"
                    Height="19"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="1">
              <TextBlock Text="{Binding KindLabel}"
                         FontSize="9"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource DangerBrush}" />
              <TextBlock Text="{Binding Subject}" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="subtle small"
                    Content="×"
                    Command="{Binding CloseCommand}" />
          </Grid>

          <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="6">
            <TextBlock Text="{Binding RulesText}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Explanation}" Classes="dim" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="2" Spacing="8" Margin="0,16,0,0">
            <Button Classes="ghost small"
                    Content="{Binding ContactLabel}"
                    Command="{Binding ContactCommand}"
                    HorizontalAlignment="Right" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="ghost small"
                      Content="{Binding CloseLabel}"
                      Command="{Binding CloseCommand}" />
              <Button Classes="primary small"
                      Content="{Binding GraceLabel}"
                      Command="{Binding GraceCommand}"
                      IsVisible="{Binding CanGrace}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Text="Still · Fokus, der bleibt"
                 Foreground="#4F5967"
                 FontSize="10"
                 HorizontalAlignment="Center" />
    </StackPanel>
  </Grid>
</Window>
