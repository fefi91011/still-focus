<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Still.App.Views.RulesView">
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="3">
        <Button Classes="tab"
                Classes.active="{Binding IsRulesTab}"
                Content="Regeln"
                Command="{Binding ShowRulesTabCommand}" />
        <Button Classes="tab"
                Classes.active="{Binding IsAllowancesTab}"
                Content="Ausnahmen"
                Command="{Binding ShowAllowancesTabCommand}" />
      </StackPanel>
      <Button Grid.Column="2"
              Classes="primary"
              Content="+ Neue Regel"
              Command="{Binding NewRuleCommand}"
              IsVisible="{Binding IsRulesTab}" />
      <Button Grid.Column="2"
              Classes="primary"
              Content="+ Neue Ausnahme"
              Command="{Binding NewAllowanceCommand}"
              IsVisible="{Binding IsAllowancesTab}" />
    </Grid>

    <Grid ColumnDefinitions="350,*">
      <Border Classes="card" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding RulesCountText}" Classes="label" IsVisible="{Binding IsRulesTab}" />
            <TextBlock Text="{Binding AllowancesCountText}" Classes="label" IsVisible="{Binding IsAllowancesTab}" />
          </Grid>

          <TextBlock Text="Noch keine Regeln. Lege die erste an – zum Beispiel Deep Work für YouTube und Reddit."
                     Classes="muted"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasRules}" />

          <ItemsControl ItemsSource="{Binding Rules}" IsVisible="{Binding IsRulesTab}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding OpenCommand}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Classes="badge"
                            Classes.danger="{Binding IsBlocked}"
                            Classes.warning="{Binding IsPaused}">
                      <TextBlock Text="{Binding StateLabel}"
                                 FontSize="8.5"
                                 Classes="muted"
                                 Classes.danger="{Binding IsBlocked}"
                                 Classes.warning="{Binding IsPaused}" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding TargetsText}"
                               FontSize="10"
                               Classes="muted"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                      <TextBlock Text="{Binding ScheduleText}"
                                 FontSize="9.5"
                                 Classes="dim"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding LimitText}" FontSize="9.5" Classes="dim" Margin="8,0,0,0" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Noch keine Ausnahmen. Erlaube gezielt, was sonst gesperrt wäre."
                     Classes="muted"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasAllowances}" />

          <ItemsControl ItemsSource="{Binding Allowances}" IsVisible="{Binding IsAllowancesTab}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding OpenCommand}">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1"
                              Classes="badge"
                              Background="{StaticResource AccentSoftBrush}"
                              IsVisible="{Binding IsActive}">
                        <TextBlock Text="AKTIV" FontSize="8.5" Foreground="{StaticResource AccentBrush}" />
                      </Border>
                      <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsPaused}">
                        <TextBlock Text="PAUSIERT" FontSize="8.5" Classes="muted" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding TargetsText}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AvailabilityText}" FontSize="9.5" Classes="dim" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="16,0,0,0">
        <Border Classes="card" IsVisible="{Binding !Editor.IsOpen}">
          <StackPanel Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,60">
            <TextBlock Text="Eine Regel, viele Möglichkeiten" Classes="h3" TextAlignment="Center" />
            <TextBlock Text="Wähle links eine Regel aus oder lege eine neue an. Zeitplan, Tageslimit, Nachfristen und Ausnahmen lassen sich frei kombinieren."
                       Classes="muted"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="360" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding Editor.IsOpen}">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Editor.EditorTitle}" Classes="h3" />
              <Button Grid.Column="1" Classes="subtle small" Content="×" Command="{Binding Editor.CancelCommand}" />
            </Grid>

            <StackPanel Spacing="5">
              <TextBlock Text="Name" Classes="label" />
              <TextBox Text="{Binding Editor.Name, Mode=TwoWay}" Watermark="z. B. Deep Work" />
            </StackPanel>

            <StackPanel Spacing="5">
              <TextBlock Text="Notiz (optional)" Classes="label" />
              <TextBox Text="{Binding Editor.Note, Mode=TwoWay}" Watermark="Warum diese Regel dir guttut" />
            </StackPanel>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="ZIELE" Classes="label" />
                <ItemsControl ItemsSource="{Binding Editor.Targets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="chip" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding KindLabel}"
                                     FontSize="8"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Display}" FontSize="10.5" VerticalAlignment="Center" />
                          <Button Classes="chipX" Content="×" Command="{Binding RemoveCommand}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding Editor.TargetInput, Mode=TwoWay}"
                           Watermark="youtube.com oder discord" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="6,0,0,0">
                    <Button Classes="ghost small" Content="Website" Command="{Binding Editor.AddWebsiteCommand}" />
                    <Button Classes="ghost small" Content="App" Command="{Binding Editor.AddAppCommand}" />
                  </StackPanel>
                </Grid>

                <Border Classes="panel" Margin="0,8,0,0" Padding="10">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="1">
                        <TextBlock Text="PROGRAMME AUS DEM ORDNER" Classes="label" />
                        <TextBlock Text="Apps aus den Programme-Ordnern auswählen, ohne den Prozessnamen zu kennen."
                                   Classes="dim"
                                   FontSize="9.5"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="ghost small"
                              Content="Programme anzeigen"
                              Command="{Binding Editor.AppPicker.ToggleCommand}"
                              Margin="8,0,0,0" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding Editor.AppPicker.IsOpen}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding Editor.AppPicker.Search, Mode=TwoWay}"
                                 Watermark="Programm suchen …" />
                        <Button Grid.Column="1"
                                Classes="subtle small"
                                Content="×"
                                Command="{Binding Editor.AppPicker.CloseCommand}"
                                Margin="6,0,0,0" />
                      </Grid>
                      <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Editor.AppPicker.Apps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="row" Command="{Binding AddCommand}" Margin="0,0,0,4">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Detail}"
                                             FontSize="9"
                                             Classes="dim"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="{Binding Editor.AppPicker.Status}"
                                 FontSize="9"
                                 Classes="dim"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                  <ComboBox ItemsSource="{Binding Editor.WebPresets}"
                            SelectedItem="{Binding Editor.SelectedPreset, Mode=TwoWay}"
                            PlaceholderText="Website-Vorlage wählen">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="11.5" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1"
                          Classes="ghost small"
                          Content="Website-Vorlage hinzufügen"
                          Command="{Binding Editor.AddPresetCommand}"
                          Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="ZEITPLAN" Classes="label" VerticalAlignment="Center" />
                  <ToggleSwitch Grid.Column="1"
                                IsChecked="{Binding Editor.IsWeekly, Mode=TwoWay}"
                                OnContent="Wochentage"
                                OffContent="Immer" />
                </Grid>

                <StackPanel Spacing="7" IsVisible="{Binding Editor.IsWeekly}">
                  <ItemsControl ItemsSource="{Binding Editor.Days}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <CheckBox Content="{Binding Label}"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Margin="0,0,11,4" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Grid ColumnDefinitions="*,*">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Von" Classes="label" />
                      <TextBox Text="{Binding Editor.StartText, Mode=TwoWay}" Watermark="09:00" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                      <TextBlock Text="Bis" Classes="label" />
                      <TextBox Text="{Binding Editor.EndText, Mode=TwoWay}" Watermark="17:00" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="TAGESLIMIT" Classes="label" />
                <Grid ColumnDefinitions="1.3*,*">
                  <StackPanel Spacing="4">
                    <TextBox Text="{Binding Editor.LimitText, Mode=TwoWay}" Watermark="leer = kein Limit" />
                    <TextBlock Text="{Binding Editor.LimitHint}"
                               FontSize="9.5"
                               Classes="dim"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnDefinitions="*,*" Margin="8,0,0,0">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Nachfrist" Classes="label" />
                      <TextBox Text="{Binding Editor.GraceText, Mode=TwoWay}" Watermark="5" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0" Spacing="4">
                      <TextBlock Text="Max./Tag" Classes="label" />
                      <TextBox Text="{Binding Editor.MaxGraceText, Mode=TwoWay}" Watermark="2" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </StackPanel>
            </Border>

            <ToggleSwitch IsChecked="{Binding Editor.Enabled, Mode=TwoWay}"
                          OnContent="Regel ist aktiv"
                          OffContent="Regel pausiert" />

            <TextBlock Text="{Binding Editor.ErrorText}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Editor.HasError}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="danger"
                      Content="Löschen"
                      Command="{Binding Editor.DeleteCommand}"
                      IsVisible="{Binding Editor.CanDelete}" />
              <Button Classes="ghost" Content="Abbrechen" Command="{Binding Editor.CancelCommand}" />
              <Button Classes="primary" Content="Speichern" Command="{Binding Editor.SaveCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding AllowanceEditor.IsOpen}">
          <StackPanel Spacing="13">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding AllowanceEditor.EditorTitle}" Classes="h3" />
              <Button Grid.Column="1" Classes="subtle small" Content="×" Command="{Binding AllowanceEditor.CancelCommand}" />
            </Grid>

            <TextBlock Text="Eine Ausnahme hebt Sperren für die gewählten Ziele auf, solange ihr Zeitfenster aktiv ist."
                       Classes="muted"
                       FontSize="10.5"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="5">
              <TextBlock Text="Name" Classes="label" />
              <TextBox Text="{Binding AllowanceEditor.Name, Mode=TwoWay}" Watermark="z. B. Mittagspause" />
            </StackPanel>

            <Border Classes="panel">
              <StackPanel Spacing="8">
                <TextBlock Text="ERLAUBTE ZIELE" Classes="label" />
                <ItemsControl ItemsSource="{Binding AllowanceEditor.Targets}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="chip" Margin="0,0,6,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding KindLabel}"
                                     FontSize="8"
                                     Foreground="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Display}" FontSize="10.5" VerticalAlignment="Center" />
                          <Button Classes="chipX" Content="×" Command="{Binding RemoveCommand}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding AllowanceEditor.TargetInput, Mode=TwoWay}"
                           Watermark="youtube.com oder steam" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="6,0,0,0">
                    <Button Classes="ghost small" Content="Website" Command="{Binding AllowanceEditor.AddWebsiteCommand}" />
                    <Button Classes="ghost small" Content="App" Command="{Binding AllowanceEditor.AddAppCommand}" />
                  </StackPanel>
                </Grid>

                <Border Classes="panel" Margin="0,8,0,0" Padding="10">
                  <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="1">
                        <TextBlock Text="PROGRAMME AUS DEM ORDNER" Classes="label" />
                        <TextBlock Text="Apps aus den Programme-Ordnern auswählen, ohne den Prozessnamen zu kennen."
                                   Classes="dim"
                                   FontSize="9.5"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1"
                              Classes="ghost small"
                              Content="Programme anzeigen"
                              Command="{Binding AllowanceEditor.AppPicker.ToggleCommand}"
                              Margin="8,0,0,0" />
                    </Grid>

                    <StackPanel Spacing="6" IsVisible="{Binding AllowanceEditor.AppPicker.IsOpen}">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding AllowanceEditor.AppPicker.Search, Mode=TwoWay}"
                                 Watermark="Programm suchen …" />
                        <Button Grid.Column="1"
                                Classes="subtle small"
                                Content="×"
                                Command="{Binding AllowanceEditor.AppPicker.CloseCommand}"
                                Margin="6,0,0,0" />
                      </Grid>
                      <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AllowanceEditor.AppPicker.Apps}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Classes="row" Command="{Binding AddCommand}" Margin="0,0,0,4">
                                <StackPanel Spacing="2">
                                  <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Detail}"
                                             FontSize="9"
                                             Classes="dim"
                                             TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                      <TextBlock Text="{Binding AllowanceEditor.AppPicker.Status}"
                                 FontSize="9"
                                 Classes="dim"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                  <ComboBox ItemsSource="{Binding AllowanceEditor.WebPresets}"
                            SelectedItem="{Binding AllowanceEditor.SelectedPreset, Mode=TwoWay}"
                            PlaceholderText="Website-Vorlage wählen">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="11.5" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1"
                          Classes="ghost small"
                          Content="Website-Vorlage hinzufügen"
                          Command="{Binding AllowanceEditor.AddPresetCommand}"
                          Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
            </Border>

            <StackPanel Spacing="5">
              <TextBlock Text="Gültig bis (optional)" Classes="label" />
              <TextBox Text="{Binding AllowanceEditor.ExpiresText, Mode=TwoWay}" Watermark="TT.MM.JJJJ · leer = unbegrenzt" />
            </StackPanel>

            <ToggleSwitch IsChecked="{Binding AllowanceEditor.Enabled, Mode=TwoWay}"
                          OnContent="Ausnahme ist aktiv"
                          OffContent="Ausnahme pausiert" />

            <TextBlock Text="{Binding AllowanceEditor.ErrorText}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       IsVisible="{Binding AllowanceEditor.HasError}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
              <Button Classes="danger"
                      Content="Löschen"
                      Command="{Binding AllowanceEditor.DeleteCommand}"
                      IsVisible="{Binding AllowanceEditor.CanDelete}" />
              <Button Classes="ghost" Content="Abbrechen" Command="{Binding AllowanceEditor.CancelCommand}" />
              <Button Classes="primary" Content="Speichern" Command="{Binding AllowanceEditor.SaveCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
