<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Still.App.Controls"
             x:Class="Still.App.Views.RulesView">
  <StackPanel Spacing="14">
    <Grid ColumnDefinitions="Auto,*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="3">
        <Button Classes="tab"
                Classes.active="{Binding IsRulesTab}"
                Content="Regeln"
                Command="{Binding ShowRulesTabCommand}" />
        <Button Classes="tab"
                Classes.active="{Binding IsAllowancesTab}"
                Content="Ausnahmen"
                Command="{Binding ShowAllowancesTabCommand}" />
      </StackPanel>
      <Button Grid.Column="2"
              Classes="primary"
              Content="+ Neue Regel"
              Command="{Binding NewRuleCommand}"
              IsVisible="{Binding IsRulesTab}" />
      <Button Grid.Column="2"
              Classes="primary"
              Content="+ Neue Ausnahme"
              Command="{Binding NewAllowanceCommand}"
              IsVisible="{Binding IsAllowancesTab}" />
    </Grid>

    <Grid ColumnDefinitions="300,*">
      <Border Classes="card" Padding="14" VerticalAlignment="Top">
        <StackPanel Spacing="9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding RulesCountText}" Classes="label" IsVisible="{Binding IsRulesTab}" />
            <TextBlock Text="{Binding AllowancesCountText}" Classes="label" IsVisible="{Binding IsAllowancesTab}" />
            <TextBlock Grid.Column="1"
                       Text="Aktiv · Geplant · Pausiert"
                       FontSize="8.5"
                       Classes="dim"
                       VerticalAlignment="Center" />
          </Grid>

          <TextBlock Text="Noch keine Regeln. Lege die erste an – zum Beispiel Deep Work für YouTube und Reddit."
                     Classes="muted"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ShowRulesEmpty}" />

          <ItemsControl ItemsSource="{Binding Rules}" IsVisible="{Binding IsRulesTab}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding OpenCommand}">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1"
                            Classes="badge"
                            Classes.danger="{Binding IsBlocked}"
                            Classes.warning="{Binding IsPaused}">
                      <TextBlock Text="{Binding StateLabel}"
                                 FontSize="8.5"
                                 Classes="muted"
                                 Classes.danger="{Binding IsBlocked}"
                                 Classes.warning="{Binding IsPaused}" />
                    </Border>
                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding TargetsText}"
                               FontSize="10"
                               Classes="muted"
                               Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                      <TextBlock Text="{Binding ScheduleText}"
                                 FontSize="9.5"
                                 Classes="dim"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding LimitText}" FontSize="9.5" Classes="dim" Margin="8,0,0,0" />
                    </Grid>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Noch keine Ausnahmen. Erlaube gezielt, was sonst gesperrt wäre."
                     Classes="muted"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding ShowAllowancesEmpty}" />

          <ItemsControl ItemsSource="{Binding Allowances}" IsVisible="{Binding IsAllowancesTab}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="row"
                        Classes.selected="{Binding IsSelected}"
                        Command="{Binding OpenCommand}">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <Border Grid.Column="1"
                              Classes="badge"
                              Background="{StaticResource AccentSoftBrush}"
                              IsVisible="{Binding IsActive}">
                        <TextBlock Text="AKTIV" FontSize="8.5" Foreground="{StaticResource AccentBrush}" />
                      </Border>
                      <Border Grid.Column="1" Classes="badge" IsVisible="{Binding IsPaused}">
                        <TextBlock Text="PAUSIERT" FontSize="8.5" Classes="muted" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding TargetsText}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding AvailabilityText}" FontSize="9.5" Classes="dim" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Margin="16,0,0,0">
        <Border Classes="card" IsVisible="{Binding NoEditorOpen}" VerticalAlignment="Top">
          <StackPanel Spacing="10" Margin="10,26">
            <TextBlock Text="Eine Regel, von oben nach unten" Classes="h2" TextAlignment="Center" />
            <TextBlock Text="Name, Zeitraum, Nachfristen und Ziele. Programme kommen aus einer echten Suche auf diesem PC, Kategorien finden Passendes selbst, Webseiten zeigen ihr Icon beim Eintippen."
                       Classes="muted"
                       FontSize="11.5"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="430"
                       HorizontalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
              <Button Classes="primary" Content="Erste Regel anlegen" Command="{Binding NewRuleCommand}" IsVisible="{Binding IsRulesTab}" />
              <Button Classes="primary" Content="Erste Ausnahme anlegen" Command="{Binding NewAllowanceCommand}" IsVisible="{Binding IsAllowancesTab}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Regel-Editor -->
        <Border Classes="card"
                Padding="0"
                IsVisible="{Binding Editor.IsOpen}"
                VerticalAlignment="Top"
                ClipToBounds="True">
          <StackPanel>
            <Border Padding="22,17"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Editor.EditorTitle}" Classes="h2" />
                  <TextBlock Text="{Binding Editor.EditorLead}" Classes="muted" FontSize="10.5" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                  <ToggleSwitch IsChecked="{Binding Editor.Enabled, Mode=TwoWay}"
                                OnContent="Regel aktiv"
                                OffContent="Pausiert" />
                  <Button Classes="subtle small" Content="×" Command="{Binding Editor.CancelCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Margin="20,16" Spacing="12">

              <!-- Name -->
              <Border Classes="panel" Padding="16">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="NAME" Classes="label" />
                    <TextBlock Text="Wie du diese Regel später wiedererkennst." Classes="dim" FontSize="9.5" />
                  </StackPanel>
                  <TextBox Text="{Binding Editor.Name, Mode=TwoWay}" Watermark="z. B. Deep Work am Morgen" />
                </StackPanel>
              </Border>

              <!-- Zeitplan -->
              <Border Classes="panel" Padding="16">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Text="ZEITPLAN" Classes="label" />
                      <TextBlock Text="An: nur in den Zeitfenstern. Aus: die Regel gilt rund um die Uhr."
                                 Classes="dim"
                                 FontSize="9.5"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1"
                                  IsChecked="{Binding Editor.ScheduleEnabled, Mode=TwoWay}"
                                  OnContent="Zeitfenster"
                                  OffContent="Immer" />
                  </Grid>

                  <TextBlock Text="Ohne Zeitfenster greift die Regel immer – das Tageslimit bestimmt dann, wie viel erlaubt ist."
                             Classes="muted"
                             FontSize="10.5"
                             TextWrapping="Wrap"
                             IsVisible="{Binding Editor.IsAlwaysMode}" />

                  <StackPanel Spacing="10" IsVisible="{Binding Editor.IsWindowMode}">
                    <ItemsControl ItemsSource="{Binding Editor.Days}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <ToggleButton Classes="day"
                                        Content="{Binding Label}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        Margin="0,0,4,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Button Classes="segment"
                              Classes.active="{Binding Editor.UseEndTime}"
                              Content="Bis Uhrzeit"
                              Command="{Binding Editor.UseEndTimeCommand}" />
                      <Button Classes="segment"
                              Classes.active="{Binding Editor.UseDuration}"
                              Content="Dauer"
                              Command="{Binding Editor.UseDurationCommand}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Von" Classes="label" />
                        <TextBox Text="{Binding Editor.StartText, Mode=TwoWay}" Watermark="09:00" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4" IsVisible="{Binding Editor.UseEndTime}">
                        <TextBlock Text="Bis" Classes="label" />
                        <TextBox Text="{Binding Editor.EndText, Mode=TwoWay}" Watermark="17:00" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="4" IsVisible="{Binding Editor.UseDuration}">
                        <TextBlock Text="Dauer in Minuten" Classes="label" />
                        <TextBox Text="{Binding Editor.DurationText, Mode=TwoWay}" Watermark="90" />
                      </StackPanel>
                    </Grid>

                    <TextBlock Text="Endet die Dauer nach Mitternacht, läuft das Zeitfenster in den nächsten Tag hinein."
                               Classes="dim"
                               FontSize="9"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Editor.UseDuration}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Limit und Nachfristen -->
              <Border Classes="panel" Padding="16">
                <StackPanel Spacing="9">
                  <StackPanel Spacing="2">
                    <TextBlock Text="LIMIT &amp; NACHFRISTEN" Classes="label" />
                    <TextBlock Text="Limit pro Tag, Anzahl der Nachfristen und wie lange eine Nachfrist gilt."
                               Classes="dim"
                               FontSize="9.5"
                               TextWrapping="Wrap" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Limit pro Tag (Min)" Classes="label" />
                      <TextBox Text="{Binding Editor.LimitText, Mode=TwoWay}" Watermark="leer = kein Limit" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
                      <TextBlock Text="Nachfristen" Classes="label" />
                      <TextBox Text="{Binding Editor.MaxGraceText, Mode=TwoWay}" Watermark="2" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="8,0,0,0" Spacing="4">
                      <TextBlock Text="Dauer (Min)" Classes="label" />
                      <TextBox Text="{Binding Editor.GraceText, Mode=TwoWay}" Watermark="5" />
                    </StackPanel>
                  </Grid>

                  <TextBlock Text="{Binding Editor.LimitHint}" FontSize="9.5" Classes="dim" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <controls:TargetPicker DataContext="{Binding Editor.Selection}" />

              <!-- Die Regel -->
              <Border Classes="hero" Padding="18">
                <StackPanel Spacing="5">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="DIE REGEL" Classes="label" />
                    <Border Grid.Column="1" Classes="badge ok" IsVisible="{Binding Editor.Enabled}">
                      <TextBlock Text="AKTIV" FontSize="8.5" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <Border Grid.Column="1" Classes="badge" IsVisible="{Binding !Editor.Enabled}">
                      <TextBlock Text="PAUSIERT" FontSize="8.5" Classes="muted" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Editor.Summary}" FontSize="15.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Editor.SummaryDetail}"
                             Classes="muted"
                             FontSize="10.5"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding Editor.ErrorText}"
                         Foreground="{StaticResource DangerBrush}"
                         FontSize="10.5"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Editor.HasError}" />
            </StackPanel>

            <Border Padding="20,13"
                    Background="#0E1217"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="danger"
                        Content="Löschen"
                        Command="{Binding Editor.DeleteCommand}"
                        IsVisible="{Binding Editor.CanDelete}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="Abbrechen" Command="{Binding Editor.CancelCommand}" />
                  <Button Classes="primary" Content="Regel speichern" Command="{Binding Editor.SaveCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Ausnahme-Editor -->
        <Border Classes="card"
                Padding="0"
                IsVisible="{Binding AllowanceEditor.IsOpen}"
                VerticalAlignment="Top"
                ClipToBounds="True">
          <StackPanel>
            <Border Padding="22,17"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding AllowanceEditor.EditorTitle}" Classes="h2" />
                  <TextBlock Text="{Binding AllowanceEditor.EditorLead}" Classes="muted" FontSize="10.5" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <ToggleSwitch IsChecked="{Binding AllowanceEditor.Enabled, Mode=TwoWay}"
                                OnContent="Aktiv"
                                OffContent="Pausiert" />
                  <Button Classes="subtle small" Content="×" Command="{Binding AllowanceEditor.CancelCommand}" />
                </StackPanel>
              </Grid>
            </Border>

            <StackPanel Margin="20,16" Spacing="12">
              <Border Classes="panel" Padding="16">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="NAME" Classes="label" />
                    <TextBlock Text="Zum Beispiel Mittagspause oder ein freier Abend." Classes="dim" FontSize="9.5" />
                  </StackPanel>
                  <TextBox Text="{Binding AllowanceEditor.Name, Mode=TwoWay}" Watermark="z. B. Mittagspause" />
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="16">
                <StackPanel Spacing="8">
                  <StackPanel Spacing="2">
                    <TextBlock Text="GÜLTIG BIS" Classes="label" />
                    <TextBlock Text="Leer lassen, wenn die Ausnahme unbefristet gelten soll." Classes="dim" FontSize="9.5" />
                  </StackPanel>
                  <TextBox Text="{Binding AllowanceEditor.ExpiresText, Mode=TwoWay}"
                           Watermark="TT.MM.JJJJ, z. B. 30.11.2026"
                           Width="240"
                           HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <controls:TargetPicker DataContext="{Binding AllowanceEditor.Selection}" />

              <TextBlock Text="{Binding AllowanceEditor.ErrorText}"
                         Foreground="{StaticResource DangerBrush}"
                         FontSize="10.5"
                         TextWrapping="Wrap"
                         IsVisible="{Binding AllowanceEditor.HasError}" />
            </StackPanel>

            <Border Padding="20,13"
                    Background="#0E1217"
                    BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Classes="danger"
                        Content="Löschen"
                        Command="{Binding AllowanceEditor.DeleteCommand}"
                        IsVisible="{Binding AllowanceEditor.CanDelete}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                  <Button Classes="ghost" Content="Abbrechen" Command="{Binding AllowanceEditor.CancelCommand}" />
                  <Button Classes="primary" Content="Ausnahme speichern" Command="{Binding AllowanceEditor.SaveCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </StackPanel>
</UserControl>
