<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Still.App.Views.TasksView">
  <Grid ColumnDefinitions="1.45*,*">
    <StackPanel Spacing="14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding SummaryText}" Classes="h3" />
          <TextBlock Text="Erledigen schaltet Bonusminuten für deine Regeln frei."
                     Classes="dim"
                     FontSize="10" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                Content="+ Neue Aufgabe"
                Command="{Binding NewTaskCommand}" />
      </Grid>

      <Border Classes="hero" Padding="18">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="Zeit zurückverdienen" Classes="h3" />
            <TextBlock Text="Aufgaben sind keine Strafe: Jede Erledigung gibt dir ein Stück Freiheit zurück. Du legst selbst fest, welche Regel profitiert."
                       Classes="muted"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       MaxWidth="560"
                       HorizontalAlignment="Left" />
          </StackPanel>
          <TextBlock Grid.Column="1"
                     Text="BONUS"
                     Classes="label"
                     Foreground="{StaticResource AccentBrush}"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock Text="Noch keine Aufgaben. Lege eine kleine Sache an, die sich heute lohnt."
                 Classes="muted"
                 FontSize="11"
                 TextWrapping="Wrap"
                 IsVisible="{Binding Empty}" />

      <ItemsControl ItemsSource="{Binding Tasks}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Padding="17" Margin="0,0,0,9">
              <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                    <Border Classes="badge" IsVisible="{Binding IsPaused}">
                      <TextBlock Text="PAUSIERT" FontSize="8.5" Classes="muted" />
                    </Border>
                    <Border Classes="badge" Background="{StaticResource AccentSoftBrush}" IsVisible="{Binding IsReflection}">
                      <TextBlock Text="MIT NOTIZ" FontSize="8.5" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Details}"
                             Classes="muted"
                             FontSize="10.5"
                             TextWrapping="Wrap"
                             IsVisible="{Binding HasDetails}" />
                  <TextBlock Text="{Binding TargetText}" Classes="dim" FontSize="9.5" />
                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="5">
                  <Border Classes="badge" Background="{StaticResource AccentSoftBrush}">
                    <TextBlock Text="{Binding RewardText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                  </Border>
                  <TextBlock Text="{Binding ProgressText}"
                             FontSize="9"
                             Classes="dim"
                             HorizontalAlignment="Right" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6"
                            Margin="0,12,0,0">
                  <Button Classes="ghost small" Content="Bearbeiten" Command="{Binding EditCommand}" />
                  <Button Classes="primary small"
                          Content="Erledigen"
                          Command="{Binding CompleteCommand}"
                          IsEnabled="{Binding CanComplete}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Text="Heute erledigt" Classes="h3" />
          <TextBlock Text="Noch nichts erledigt. Der Tag ist nicht vorbei."
                     Classes="muted"
                     FontSize="10.5"
                     IsVisible="{Binding !HasCompletions}" />
          <ItemsControl ItemsSource="{Binding CompletionsToday}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="panel" Margin="0,0,0,7">
                  <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding MinutesText}" FontSize="10" Foreground="{StaticResource AccentBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Reflection}" FontSize="9.5" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasReflection}" />
                      <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="9" Classes="dim" />
                    </Grid>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Column="1" Margin="16,0,0,0">
      <Border Classes="card" IsVisible="{Binding !Editor.IsOpen}">
        <StackPanel Spacing="9" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,60">
          <TextBlock Text="Eine Aufgabe, eine Belohnung" Classes="h3" TextAlignment="Center" />
          <TextBlock Text="Wähle links eine Aufgabe zum Bearbeiten oder lege eine neue an. Die Gutschrift landet direkt im Budget der gewählten Regel."
                     Classes="muted"
                     FontSize="11"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="330" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding Editor.IsOpen}" VerticalAlignment="Top">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Editor.EditorTitle}" Classes="h3" />
            <Button Grid.Column="1" Classes="subtle small" Content="×" Command="{Binding Editor.CancelCommand}" />
          </Grid>

          <StackPanel Spacing="5">
            <TextBlock Text="Titel" Classes="label" />
            <TextBox Text="{Binding Editor.Title, Mode=TwoWay}" Watermark="z. B. 20 Minuten spazieren" />
          </StackPanel>

          <StackPanel Spacing="5">
            <TextBlock Text="Details (optional)" Classes="label" />
            <TextBox Text="{Binding Editor.Details, Mode=TwoWay}"
                     Classes="multiline"
                     Watermark="Was genau machst du?" />
          </StackPanel>

          <Grid ColumnDefinitions="*,*">
            <StackPanel Spacing="4">
              <TextBlock Text="Belohnung (Min)" Classes="label" />
              <TextBox Text="{Binding Editor.RewardText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="4">
              <TextBlock Text="Max. pro Tag" Classes="label" />
              <TextBox Text="{Binding Editor.MaxPerDayText, Mode=TwoWay}" />
            </StackPanel>
          </Grid>

          <StackPanel Spacing="5">
            <TextBlock Text="Gutschrift für" Classes="label" />
            <ComboBox ItemsSource="{Binding RuleOptions}"
                      SelectedItem="{Binding Editor.SelectedRule, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontSize="11.5" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <CheckBox Content="Kurze Notiz nach dem Erledigen verlangen"
                    IsChecked="{Binding Editor.RequireReflection, Mode=TwoWay}" />

          <ToggleSwitch IsChecked="{Binding Editor.Enabled, Mode=TwoWay}"
                        OnContent="Aufgabe ist aktiv"
                        OffContent="Aufgabe pausiert" />

          <TextBlock Text="{Binding Editor.ErrorText}"
                     Foreground="{StaticResource DangerBrush}"
                     FontSize="10.5"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Editor.HasError}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="danger"
                    Content="Löschen"
                    Command="{Binding Editor.DeleteCommand}"
                    IsVisible="{Binding Editor.CanDelete}" />
            <Button Classes="ghost" Content="Abbrechen" Command="{Binding Editor.CancelCommand}" />
            <Button Classes="primary" Content="Speichern" Command="{Binding Editor.SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
