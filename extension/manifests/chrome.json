{
  "manifest_version": 3,
  "name": "Still Website Blocker",
  "short_name": "Still",
  "version": "0.1.0",
  "description": "Zeigt beim Sperren einer Website dieselben Still-Aktionen wie bei gesperrten Apps.",
  "minimum_chrome_version": "121",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47821/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Still Website Blocker"
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
