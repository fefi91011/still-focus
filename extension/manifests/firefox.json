{
  "manifest_version": 3,
  "name": "Still Website Blocker",
  "short_name": "Still",
  "version": "0.2.2",
  "description": "Zeigt beim Sperren einer Website dieselben Still-Aktionen wie bei gesperrten Apps.",
  "permissions": [
    "webNavigation",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:47821/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Still Website Blocker",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "still-website-blocker@local",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
